# Select "ollama" for local development or "gemini" for cloud generation.
AI_PROVIDER=ollama

# Local Ollama defaults. The Gemini API key is only needed when AI_PROVIDER=gemini.
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated browser origins allowed to call the backend.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
